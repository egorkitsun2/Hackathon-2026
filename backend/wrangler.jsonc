{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hackathon-2026-team-voice",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "team-voice-db",
      // Placeholder for local development. Replace with ID from
      // 'wrangler d1 create team-voice-db' before remote deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
