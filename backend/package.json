{
  "name": "team-voice-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply team-voice-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply team-voice-db --remote"
  },
  "dependencies": {
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261109.1": true
  }
}
